<Window x:Class="CurrencyWpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Exchange Office" Height="580" Width="620">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Currency Exchange Office" 
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Login/Register -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Username:" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="UsernameInput" Width="100" Margin="5,0"/>
            <TextBlock Text="Password:" VerticalAlignment="Center" Width="70"/>
            <PasswordBox x:Name="PasswordInput" Width="100" Margin="5,0"/>
            <Button Content="Register" Width="80" Margin="5,0" Click="Register_Click"/>
        </StackPanel>

        <!-- Balance -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Top Up (PLN):" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="TopUpInput" Width="80" Margin="5,0"/>
            <Button Content="Top Up" Width="70" Margin="5,0" Click="TopUp_Click"/>
            <Button Content="My Balance" Width="90" Margin="5,0" Click="Balance_Click"/>
        </StackPanel>

        <!-- Exchange Rates -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="USD" Width="60" Margin="0,0,5,0" Click="USD_Click"/>
            <Button Content="EUR" Width="60" Margin="0,0,5,0" Click="EUR_Click"/>
            <Button Content="GBP" Width="60" Margin="0,0,5,0" Click="GBP_Click"/>
            <TextBox x:Name="CurrencyInput" Width="60" Margin="5,0"/>
            <Button Content="Get Rate" Width="80" Margin="5,0" Click="GetRate_Click"/>
            <TextBox x:Name="DateInput" Width="90" Margin="5,0" Text="2024-01-15"/>
            <Button Content="Historical" Width="80" Margin="5,0" Click="Historical_Click"/>
        </StackPanel>

        <!-- Buy/Sell -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Currency:" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="TradeCodeInput" Width="60" Margin="5,0"/>
            <TextBlock Text="Amount:" VerticalAlignment="Center" Width="60"/>
            <TextBox x:Name="TradeAmountInput" Width="60" Margin="5,0"/>
            <Button Content="Buy" Width="60" Margin="5,0" Click="Buy_Click"/>
            <Button Content="Sell" Width="60" Margin="5,0" Click="Sell_Click"/>
            <Button Content="History" Width="70" Margin="5,0" Click="History_Click"/>
        </StackPanel>

        <TextBox Grid.Row="5" x:Name="ResultBox" 
                 IsReadOnly="True" FontSize="13"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>